# Copy this file to .env for local development.
# Genelife.API loads .env from its content root or a parent directory.
# Keep .env out of source control.

# Shared secret accepted by POST /api/auth/token when requesting Admin tokens.
Auth__Jwt__AdminSecret=dev-only-admin-secret-change-me

# Allow the loopback admin UI to obtain an admin token without the shared secret.
# Enable only when the API and admin UI run on the same machine.
# Auth__Jwt__AllowLocalAdmin=true
