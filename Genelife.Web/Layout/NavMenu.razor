<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">GeneLife Admin</a>
        <button type="button" class="navbar-toggler" title="Navigation menu"
                aria-label="Navigation menu" aria-controls="@NavMenuId"
                aria-expanded="@NavMenuExpanded" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

<div id="@NavMenuId" class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="data" Match="NavLinkMatch.Prefix">
                <span class="bi bi-table-nav-menu" aria-hidden="true"></span> Data
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="map" Match="NavLinkMatch.Prefix">
                <span class="bi bi-map-nav-menu" aria-hidden="true"></span> Map
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="economy" Match="NavLinkMatch.Prefix">
                <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> Economy
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="housing" Match="NavLinkMatch.Prefix">
                <span class="bi bi-house-nav-menu" aria-hidden="true"></span> Housing
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="lifecycle" Match="NavLinkMatch.Prefix">
                <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Life Stages
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="family" Match="NavLinkMatch.Prefix">
                <span class="bi bi-diagram-3-nav-menu" aria-hidden="true"></span> Family
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="players" Match="NavLinkMatch.Prefix">
                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Players
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="appearance" Match="NavLinkMatch.Prefix">
                <span class="bi bi-palette-nav-menu" aria-hidden="true"></span> Appearance
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="causes" Match="NavLinkMatch.Prefix">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Causes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="consumption" Match="NavLinkMatch.Prefix">
                <span class="bi bi-lightning-charge-nav-menu" aria-hidden="true"></span> Consumption
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="social" Match="NavLinkMatch.Prefix">
                <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Social
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private const string NavMenuId = "nav-menu";
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // ARIA state values must be the literal lowercase strings "true"/"false".
    // A raw bool renders as "True"/"False", which assistive technology rejects,
    // so the state is projected explicitly rather than bound directly.
    private string NavMenuExpanded => collapseNavMenu ? "false" : "true";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
