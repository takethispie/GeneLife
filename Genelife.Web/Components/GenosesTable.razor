@using Genelife.Web.Models

<div class="table-responsive">
    <table class="table table-sm table-striped table-hover align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Age</th>
                <th scope="col">Controller</th>
                <th scope="col" class="text-end">Wallet</th>
                <th scope="col">Hunger</th>
                <th scope="col">Energy</th>
                <th scope="col">Hygiene</th>
                <th scope="col">Bladder</th>
                <th scope="col">Action</th>
                <th scope="col">Time left</th>
                <th scope="col">Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var genos in Genoses.OrderBy(s => s.NetworkId))
            {
                <tr>
                    <td class="font-monospace text-muted">#@genos.NetworkId</td>
                    <td class="fw-semibold">@genos.Name</td>
                    <td>@genos.Age</td>
                    <td>
                        @if (genos.IsPlayerControlled)
                        {
                            <span class="badge text-bg-primary">Player</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">NPC</span>
                        }
                    </td>
                    <td class="text-end">@genos.WalletBalance.ToString("0.00")</td>
                    <td class="@NeedClass(genos.Hunger)">@genos.Hunger.ToString("0.0")</td>
                    <td class="@NeedClass(genos.Energy)">@genos.Energy.ToString("0.0")</td>
                    <td class="@NeedClass(genos.Hygiene)">@genos.Hygiene.ToString("0.0")</td>
                    <td class="@NeedClass(genos.Bladder)">@genos.Bladder.ToString("0.0")</td>
                    <td>@genos.CurrentAction</td>
                    <td>@genos.TimeRemaining.ToString("0.00")</td>
                    <td class="font-monospace text-muted">@genos.X.ToString("0.0"), @genos.Y.ToString("0.0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<GenosData> Genoses { get; set; } = Array.Empty<GenosData>();

    private static string NeedClass(float value)
    {
        if (value < 25f)
            return "text-danger fw-semibold";

        return value < 50f ? "text-warning-emphasis" : string.Empty;
    }
}
