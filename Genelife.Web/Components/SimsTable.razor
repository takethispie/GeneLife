@using Genelife.Web.Models

<div class="table-responsive">
    <table class="table table-sm table-striped table-hover align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Age</th>
                <th scope="col">Controller</th>
                <th scope="col" class="text-end">Wallet</th>
                <th scope="col">Hunger</th>
                <th scope="col">Energy</th>
                <th scope="col">Hygiene</th>
                <th scope="col">Bladder</th>
                <th scope="col">Action</th>
                <th scope="col">Time left</th>
                <th scope="col">Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sim in Sims.OrderBy(s => s.NetworkId))
            {
                <tr>
                    <td class="font-monospace text-muted">#@sim.NetworkId</td>
                    <td class="fw-semibold">@sim.Name</td>
                    <td>@sim.Age</td>
                    <td>
                        @if (sim.IsPlayerControlled)
                        {
                            <span class="badge text-bg-primary">Player</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">NPC</span>
                        }
                    </td>
                    <td class="text-end">@sim.WalletBalance.ToString("0.00")</td>
                    <td class="@NeedClass(sim.Hunger)">@sim.Hunger.ToString("0.0")</td>
                    <td class="@NeedClass(sim.Energy)">@sim.Energy.ToString("0.0")</td>
                    <td class="@NeedClass(sim.Hygiene)">@sim.Hygiene.ToString("0.0")</td>
                    <td class="@NeedClass(sim.Bladder)">@sim.Bladder.ToString("0.0")</td>
                    <td>@sim.CurrentAction</td>
                    <td>@sim.TimeRemaining.ToString("0.00")</td>
                    <td class="font-monospace text-muted">@sim.X.ToString("0.0"), @sim.Y.ToString("0.0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<SimData> Sims { get; set; } = Array.Empty<SimData>();

    private static string NeedClass(float value)
    {
        if (value < 25f)
            return "text-danger fw-semibold";

        return value < 50f ? "text-warning-emphasis" : string.Empty;
    }
}
