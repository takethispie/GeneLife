@page "/causes"
@using Genelife.Web.Services
@inject GameDataService GameData

<PageTitle>Causes</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="mb-1">Causes</h1>
        <p class="text-muted mb-0">
            Structured cause facts for the play surface: code, subject, value, unit and since-tick.
            The server sends facts only &mdash; the client owns the phrasing.
        </p>
    </div>
    <button class="btn btn-primary" type="button" @onclick="LoadAsync" disabled="@isLoading">Refresh</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger"><div class="fw-semibold">Could not load causes.</div><div class="small">@error</div></div>
}

<div class="row g-4">
    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Genoses</span>
                <span class="small text-muted">@(world?.Genoses.Count ?? 0) living</span>
            </div>
            <div class="list-group list-group-flush" style="max-height: 34rem; overflow-y: auto;">
                @if (world is not null)
                {
                    @foreach (var genos in world.Genoses)
                    {
                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selected == genos.NetworkId ? "active" : null)"
                                @onclick="() => SelectAsync(genos)">
                            <span class="fw-semibold">@genos.Name</span>
                            <span class="small opacity-75">#@genos.NetworkId</span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        @if (causes is null)
        {
            <div class="alert alert-secondary">Select a genos to inspect its cause facts.</div>
        }
        else
        {
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>@causes.Name <span class="text-muted small">#@causes.NetworkId</span></span>
                    <span class="small text-muted">as of tick @causes.AsOfTick &middot; @causes.Facts.Count facts</span>
                </div>
                @if (causes.Facts.Count == 0)
                {
                    <div class="card-body text-muted">No cause facts are derivable for this genos. The client shows the raw measure and says nothing more.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Code</th>
                                    <th scope="col">Subject</th>
                                    <th scope="col" class="text-end">Value</th>
                                    <th scope="col">Unit</th>
                                    <th scope="col" class="text-end">Since tick</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fact in causes.Facts)
                                {
                                    <tr>
                                        <td><code>@fact.Code</code></td>
                                        <td>@fact.Subject</td>
                                        <td class="text-end">@fact.Value.ToString("0.##")</td>
                                        <td>@fact.Unit</td>
                                        <td class="text-end">@fact.SinceTick</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <p class="small text-muted mt-2 mb-0">
                Codes are stable contract tokens. Rendering (&ldquo;last meal 11 h ago&rdquo;) belongs to the client, not the server.
            </p>
        }
    </div>
</div>

@code {
    private WorldData? world;
    private GenosCausesData? causes;
    private ulong? selected;
    private string? error;
    private bool isLoading;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        try
        {
            world = await GameData.GetWorldDataAsync();
            if (selected is not null)
            {
                causes = await GameData.GetCausesAsync(selected.Value);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectAsync(GenosData genos)
    {
        selected = genos.NetworkId;
        error = null;
        try
        {
            causes = await GameData.GetCausesAsync(genos.NetworkId);
        }
        catch (Exception ex)
        {
            causes = null;
            error = ex.Message;
        }
    }
}
