@page "/"

<PageTitle>GeneLife Admin</PageTitle>

<div class="mb-4">
    <h1 class="mb-1">GeneLife Admin</h1>
    <p class="text-muted mb-0">
        Live admin console for the running GeneLife simulation. Open any section below —
        each one reads the current world state from the API.
    </p>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="data">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Data</h2>
                <p class="card-text text-muted mb-0">Live snapshot of the entities in the running simulation.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="map">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Map</h2>
                <p class="card-text text-muted mb-0">Generated world layout, building footprints and live player positions.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="economy">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Economy</h2>
                <p class="card-text text-muted mb-0">Closed money loop, fiscal accounts, household cash and company solvency.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="housing">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Housing</h2>
                <p class="card-text text-muted mb-0">Tenancies, rent, utilities, arrears and the rent ladder.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="lifecycle">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Life Stages</h2>
                <p class="card-text text-muted mb-0">Education, work, retirement, health, mortality and population balance.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="family">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Family</h2>
                <p class="card-text text-muted mb-0">Traits, relationships, partnerships, pregnancies, children, guardianship and family health.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="players">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Players</h2>
                <p class="card-text text-muted mb-0">Player-controlled genoses, employment, household, pantry, family state and continuation.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="appearance">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Appearance</h2>
                <p class="card-text text-muted mb-0">Deterministic trait-derived descriptors, layered portraits and family resemblance.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="causes">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Causes</h2>
                <p class="card-text text-muted mb-0">Structured cause facts per genos: code, subject, value, unit and since-tick.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="consumption">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Consumption</h2>
                <p class="card-text text-muted mb-0">Utility networks, household meters, outages, grocery stock, spoilage and nutrition.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a class="card h-100 text-decoration-none" href="social">
            <div class="card-body">
                <h2 class="h6 card-title mb-1">Social</h2>
                <p class="card-text text-muted mb-0">Presence, venues, reports, social edges, partnerships and moderation audit.</p>
            </div>
        </a>
    </div>
</div>
