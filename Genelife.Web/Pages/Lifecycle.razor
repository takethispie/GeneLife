    private Task TriggerWaveAsync() =>
        RunAsync(() => GameData.TriggerImmigrationWaveAsync(waveCount), "Immigration wave queued.");

    private Task TopUpPensionAsync() =>
        RunAsync(() => GameData.TopUpPensionFundAsync(pensionTopUp), "Pension top-up queued.");

    private void LoadSchool(SchoolData school)
    {
        editSchoolId = school.NetworkId;
        editSchoolCapacity = school.Capacity;
        editSchoolQuality = school.Quality;
        editSchoolCost = school.MonthlyCost;
        editSchoolEmphasis = string.IsNullOrWhiteSpace(school.Emphasis) ? "Programming" : school.Emphasis.Split(',')[0];
    }

    private Task SaveSchoolAsync() =>
        editSchoolId is null
            ? Task.CompletedTask
            : RunAsync(
                async () =>
                {
                    await GameData.UpdateSchoolAsync(
                        editSchoolId.Value,
                        editSchoolCapacity,
                        (float)editSchoolQuality,
                        editSchoolCost,
                        editSchoolEmphasis);
                    editSchoolId = null;
                },
                "School updated.");

    private Task GenerateAsync() =>
        RunAsync(
            () => GameData.GeneratePopulationAsync(generateTotal, generateSeed),
            "Population generation queued.");

    private Task SetTargetAsync() =>
        RunAsync(
            () => GameData.SetPopulationTargetAsync(targetPopulation),
            "Population target updated.");

    private static string Percent(decimal value) => (value * 100m).ToString("0.0") + "%";

    private static string Percent(float value) => Percent((decimal)value);

    private static string Money(decimal value) => value.ToString("N0");

    private static string Badge(string? level) => level switch
    {
        "Pass" => "text-bg-success",
        "Warn" => "text-bg-warning",
        "Fail" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private static string StageBadge(string stage) => stage switch
    {
        "Education" => "text-bg-info",
        "Work" => "text-bg-primary",
        "Retirement" => "text-bg-warning",
        "Elderly" => "text-bg-secondary",
        _ => "text-bg-light"
    };

    public ValueTask DisposeAsync()
    {
        timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
