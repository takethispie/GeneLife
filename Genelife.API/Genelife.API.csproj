<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- V6 runtime tuning: the 20 Hz simulation loop allocates heavily per tick,
         so server GC keeps gen2 pauses off the tick thread and PGO improves
         steady-state throughput. See docs/plans/roadmap-v6. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="Marten" Version="9.62.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.1" />
    <PackageReference Include="WolverineFx" Version="6.64.2" />
    <PackageReference Include="WolverineFx.Http" Version="6.64.2" />
    <PackageReference Include="WolverineFx.Marten" Version="6.64.2" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.64.2" />
    <PackageReference Include="WolverineFx.SignalR" Version="6.64.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeneLife.ServiceDefaults\GeneLife.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Genelife\Genelife.csproj" />
    <ProjectReference Include="..\Genelife.Messages\Genelife.Messages.csproj" />
    <ProjectReference Include="..\Genelife.Contracts\Genelife.Contracts.csproj" />
  </ItemGroup>

</Project>
