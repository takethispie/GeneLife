{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=genelife;Username=genelife;Password=genelife"
  },
  "FeatureFlags": {
    "UseWolverineEndpoints": true,
    "UseMartenReads": true,
    "UseCommandQueue": true,
    "UseSagas": false,
    "UseSignalR": true,
    "UseOutbox": false
  },
  "SignalR": {
    "MaxIntentPayloadBytes": 4096,
    "TickIntervalMs": 40,
    "AutoCreatePlayerSim": true,
    "Viewport": {
      "DefaultRadius": 32,
      "MinRadius": 4,
      "MaxRadius": 256
    }
  },
  "Chat": {
    "MaxLength": 240,
    "SayRadius": 12,
    "RetentionDays": 30,
    "SayPerWindow": 6,
    "VenuePerWindow": 6,
    "WhisperPerWindow": 3,
    "RateWindowSeconds": 10,
    "EmoteCooldownSeconds": 3,
    "EmoteVenueBudget": 20,
    "EmoteVenueWindowSeconds": 10,
    "RetentionSweepMinutes": 60,
    "GlobalSayPerWindow": 60,
    "GlobalVenuePerWindow": 40,
    "GlobalWhisperPerWindow": 20
  },
  "SocialGraph": {
    "FriendRequestLifetimeTicks": 100,
    "FriendDeclineCooldownTicks": 600,
    "ReportDedupeWindowTicks": 600
  },
  "Venue": {
    "TicksPerDay": 24,
    "CafeCapacity": 8,
    "ParkCapacity": 20,
    "CivicCapacity": 16,
    "OfficeLobbyCapacity": 12,
    "SchoolYardCapacity": 24,
    "CafeOpenFromTick": 7,
    "CafeOpenToTick": 22,
    "ParkOpenFromTick": 6,
    "ParkOpenToTick": 22,
    "CivicOpenFromTick": 6,
    "CivicOpenToTick": 22,
    "OfficeLobbyOpenFromTick": 8,
    "OfficeLobbyOpenToTick": 18,
    "SchoolYardOpenFromTick": 8,
    "SchoolYardOpenToTick": 15,
    "ActivityCooldownTicks": 5,
    "RejectionNoticeCooldownTicks": 25,
    "RecentActivityTicks": 100,
    "RecentActivityLimit": 8,
    "ConfigureRefreshTicks": 25
  },
  "SocialLimits": {
    "PresencePerPlayer": 4,
    "PresenceGlobal": 20,
    "PresenceWindowSeconds": 10
  },
  "Moderation": {
    "DefaultMuteTicks": 300,
    "DefaultSuspendChatTicks": 300,
    "ReportRetentionTicks": 1200,
    "ActionRetentionTicks": 2400,
    "ReportWindowTicks": 1200,
    "RepeatOffenderThreshold": 3,
    "QueueTake": 100,
    "RetentionSweepMinutes": 60
  }
}
