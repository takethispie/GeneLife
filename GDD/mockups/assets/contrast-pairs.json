    { "foreground": "--accent", "background": "--paper", "minimum": 4.5, "use": "accent text and links" },
    { "foreground": "--body", "background": "--paper", "minimum": 4.5, "use": "needs domain" },
    { "foreground": "--work", "background": "--paper", "minimum": 4.5, "use": "work domain" },
    { "foreground": "--social", "background": "--paper", "minimum": 4.5, "use": "social domain" },
