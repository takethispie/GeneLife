{
  "name": "genelife-browser-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "contracts:rest": "npx --yes openapi-typescript@7 http://localhost:5288/swagger/v1/swagger.json -o src/contracts/rest.generated.ts",
    "preview": "vite preview",
    "soak": "node scripts/soak.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^11.0.0",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
