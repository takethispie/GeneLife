# Copy to `.env.local` for development.
VITE_API_BASE_URL=http://localhost:5288
# Optional; defaults to ${VITE_API_BASE_URL}/hubs/world
# VITE_HUB_URL=http://localhost:5288/hubs/world
VITE_LOG_LEVEL=info
# Fixture mode shows the recorded contract fixtures without a server.
VITE_USE_FIXTURES=false
# Prefix for generated per-tab player ids. Override with ?playerId=...
VITE_DEV_PLAYER_ID=dev-player
# Default requested viewport radius (server clamps it).
VITE_VIEWPORT_RADIUS=32
